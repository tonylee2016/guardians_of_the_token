{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.py\""
          },
          {
            "type": "command",
            "command": "python3 -m guardians_of_the_token.claude.session_start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m guardians_of_the_token.claude.pre_tool_guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m guardians_of_the_token.claude.post_tool_guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m guardians_of_the_token.claude.prompt_guard"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m guardians_of_the_token.claude.pre_compact"
          }
        ]
      }
    ]
  }
}
